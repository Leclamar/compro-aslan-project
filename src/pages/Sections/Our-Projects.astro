---

<section class="box-border px-45">
    <header class="text-left mb-10">
        <h3 class="text-accent">Aslan Project / Our Projects</h3>
        <h1 class="text-text-primary text-section font-bold mb-2">
            ALL PROJECTS
        </h1>

        <p class="text-xs">Explore our selected architectural projects.</p>
    </header>
    
    <main class="mb-32">
        <section class="grid grid-cols-2 gap-10">
            {items.map(({ img, title, location }) => (
                <div class="grid grid-rows-[1fr_auto]">
                    <Image src={img} alt={title} class="w-full h-full object-cover rounded-lg border-accent border" />
                    <p class="mt-6 mb-2 font-sans text-text-primary text-xl font-semibold">{title}</p>
                    <p class="text-text-secondary text-xs">{location}</p>
                </div>
            ))}
        </section>
    </main>
</section>