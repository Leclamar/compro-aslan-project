const items =[
    {
        img : AquaInformationBoothDesign,
        title : "Aqua Information Booth Design",
    },
    {
        img : BillyardClubDesign,
        title : "Billyard Club Design"
    },
    {
        img : MrTeukuHouseDesign,
        title : "Mr. Teuku House Design"
    },
    {
        img : FestivalEventVenueDesign,
        title : "Festival Event Venue Design"
    },
    {
        img : KALaundryInteriorDesignBuild,
        title : "KA Laundry Interior Design & Build"
    },
    {
        img : KedaiAsikInteriorDesignBuild,
        title : "Kedai Asik Interior Design & Build"
    },
    {
        img : KopikiranCoffeeEateryInteriorDesignBuild,
