---
import {Image} from "astro:assets";

const modules = import.meta.glob<{ default: ImageMetadata }>(
    "../../assets/portfolio/*.{jpg,jpeg,png,webp}",
    { eager: true }
);

const gallery: Record<string, ImageMetadata[]> = {};
Object.entries(modules)
    .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
    .forEach(([path, mod]) => {
        const file = path.split("/").pop()!.replace(/\.[^.]+$/, "");
        const key = file.replace(/\s*\d+$/, "").trim().normalize("NFC");
        (gallery[key] ??= []).push(mod.default);
    });

const items =[
    {
        key : "Aqua Information Booth Design",
        title : "Aqua Information Booth Design",
    },
    {
        key : "Billyard Club Design",
        title : "Billyard Club Design"
    },
    {
        key : "Mr. Teuku House Design",
        title : "Mr. Teuku House Design"
    },
    {
        key : "Festival Event Venue Design",
        title : "Festival Event Venue Design"
    },
    {
        key : "KA Laundry Interior Design & Build",
        title : "KA Laundry Interior Design & Build"
    },
    {
        key : "Kedai Asik Interior Design & Build",
        title : "Kedai Asik Interior Design & Build"
    },
    {
