        title : "TYA Teknik Design"
    }
].map((item) => ({
    ...item,
    images: gallery[item.key.normalize("NFC")] ?? []
}));
---

<section>
    <header class="text-center mb-10">
        <h1 class="text-text-primary text-section font-bold mb-2">
            Our Portfolio
        </h1>

        <p class="text-xs">A collection of spaces, ideas, and architectural expressions</p>
    </header>
    
    <main class="px-45 mb-32">
        <section class="grid grid-cols-2 gap-10">
            {items.map(({ images, title }) => (
                <div class="grid grid-rows-[1fr_auto] gap-4">
                    <Image src={images[0]} alt={title} class="w-full h-full object-cover rounded-lg border-accent border" />
                    <h2 class="text-text-primary text-lg font-semibold">{title}</h2>
                </div>
            ))}
        </section>
    </main>
</section>