        title : "Mr. Erik House Design"
    },
    {
        img : MrHaikalHouseDesign,
        title : "Mr. Haikal House Design"
    },
    {
        img : MrNovanHouseDesign,
        title : "Mr. Novan House Design"
    },
    {
        img : MsAsniHouseDesign,
        title : "Ms. Asni House Design"
    },
    {
        img : MsLinaHouseDesign,
        title : "Ms. Lina House Design"
    },
