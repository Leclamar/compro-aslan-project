---
interface Props {
    number?: string;
    title: string;
    desc: string;
    align?: "left" | "center" | "right";
    icon?: string;
}

const {number, title, desc, align = "left"} = Astro.props;

const alignClasses = {
    left: "text-left",
    center: "text-center",
    right: "text-right",
};

const hasIcon = Astro.slots.has("icon");
const alignClass = hasIcon ? alignClasses.left : alignClasses[align];

---

<div class:list={[alignClass, hasIcon && "flex flex-row items-center gap-4"]}>
    <div class:list={["text-accent font-bold", { "mb-4": !hasIcon, "shrink-0": hasIcon }]}>
        {hasIcon ? <slot name="icon" /> : number}
    </div>

    <div>
        <p class:list={["font-bold", {"mb-0.5 text-accent": hasIcon}]}>{title}</p>
        <p class:list={["text-xs", "font-extralight", {"text-text-secondary" : !hasIcon, "text-text-primary": hasIcon}]}>{desc}</p>
    </div>
</div>