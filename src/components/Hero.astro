---
import { Image } from "astro:assets";
import heroBg from "../assets/hero/hero.jpg";
---

<section id="home" class="relative min-h-screen w-full overflow-hidden">

  <Image src={heroBg} alt="Kafe The Breeze karya Aslan Project" loading="eager" class="absolute inset-0 h-full w-full object-cover" />

  <div class="absolute inset-0 bg-linear-to-t from-primary/80 via-primary/20 to-primary/40"></div>

  <div class="relative z-10 mx-auto flex min-h-screen max-w-content flex-col justify-end px-6 md:px-12 pb-16 md:pb-20">

    <h1 class="font-display text-hero text-text-light">
      Designing Spaces.<br />
      <span class="text-accent">Building Trust.</span>
    </h1>

    <div class="mt-6 flex flex-wrap gap-3">
      <a href="#projects" class="inline-flex items-center justify-center rounded-md bg-accent px-6 py-3 text-sm font-medium text-primary transition-opacity hover:opacity-90">Explore Our Projects</a>
      <a href="#services" class="inline-flex items-center justify-center rounded-md border border-text-light px-6 py-3 text-sm font-medium text-text-light transition-colors hover:bg-text-light/10">Our Services</a>
    </div>

    <!-- Scroll to explore: lingkaran isi panah ke bawah -->
    <a href="#about" class="mt-12 inline-flex items-center gap-3 text-xs uppercase tracking-widest text-text-light">
      <span class="grid size-8 place-items-center rounded-full border border-text-light/60">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M12 5v14M6 13l6 6 6-6" />
        </svg>
      </span>
      Scroll to explore
    </a>
  </div>
</section>