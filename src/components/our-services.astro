---
import { Image } from "astro:assets";
import architecture from "../assets/services/architecture.png";  
import construction from "../assets/services/construction.jpg";
import interior from "../assets/services/interior.jpg";
import landscape from "../assets/services/landscape.jpg";

const services = [
    {
        title: "ARCHITECTURE",
        desc: "Architectural planning and building design.",
        image: architecture,
        alt: "Desain arsitektur kafe The Breeze"
    },
    {
        title: "CONSTRUCTION",
        desc: "Quality construction and project execution.",
        image: construction,
        alt: "Pekerjaan konstruksi rumah"
    },
    {
        title: "INTERIOR DESIGN",
        desc: "Functional and aesthetic interior spaces.",
        image: interior,
        alt: "Desain interior kafe"
    },
    {
        title: "LANDSCAPE DESIGN",
        desc: "Beautiful outdoor and landscape environments.",
        image: landscape,
        alt: "Desain landscape taman"
    }
]
---

<section id="services" class="px-6 md:px-20 lg:px-45 py-section">
    <header class="text-center">
        <p class="text-sm font-bold uppercase tracking-wider text-accent">What We Do</p>
        <h2 class="mt-1 text-section">Our Services</h2>
        <p class="mt-2 text-xs text-text-primary/80">Creating spaces through thoughtful design and construction.</p>
    </header>

    <div class="mx-auto mt-10 grid max-w-4xl gap-y-10 md:grid-cols-2 md:gap-x-[19%]">
        {services.map((s, i) => (
        <article>
            <!-- aspect-[7/4] = rasio foto di Figma (231x132); object-cover = foto dipotong rapi, tidak gepeng -->
            <Image src={s.image} alt={s.alt} class="aspect-[7/4] w-full object-cover" />

            <!-- i + 1 = nomor otomatis: 1, 2, 3, 4 -->
            <h3 class="mt-3 font-display text-2xl">{i + 1}. {s.title}</h3>
            <p class="text-xs text-text-primary/80">{s.desc}</p>
        </article>
        ))}
    </div>
</section>